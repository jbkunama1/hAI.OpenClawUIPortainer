# OpenClaw Backend Konfiguration
PORT=3000

# LLM Endpoint (OpenAI-kompatibel)
# Beispiele:
#   https://api.openai.com
#   https://api.anthropic.com (mit Adapter)
#   https://api.together.xyz
#   http://ollama:11434 (lokal)
LLM_ENDPOINT=https://api.openai.com

# Domain für Traefik Routing (optional)
DOMAIN=deine-domain.de

# Open WebUI Settings
WEBUI_AUTH=false
WEBUI_NAME=OpenClaw UI
