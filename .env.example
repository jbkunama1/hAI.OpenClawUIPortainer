# Gateway-Token: Wird von Open WebUI als OPENAI_API_KEY verwendet.
# Bitte durch ein langes zufälliges Token ersetzen.
GATEWAY_TOKEN=change-me-to-a-long-random-token

# OpenAI-kompatibler LLM-Endpunkt, immer inklusive /v1
# OpenAI:
LLM_BASE_URL=https://api.openai.com/v1
# OpenRouter:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# Ollama im gleichen Docker-Netzwerk:
# LLM_BASE_URL=http://ollama:11434/v1

# API-Key des LLM-Anbieters
LLM_API_KEY=sk-your-provider-key

# Externer Port der WebUI
WEBUI_PORT=8666

# WebUI-Einstellungen
WEBUI_AUTH=true
WEBUI_NAME=OpenClaw Lab
TZ=Europe/Berlin

# Optionale MCP-Server als JSON-Array
# Beispiel:
# MCP_SERVERS_JSON=[{"name":"fhem","transport":"http","url":"http://fhem-mcp:3001","enabled":true}]
MCP_SERVERS_JSON=[]
