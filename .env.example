# Sicherheits-Token für das OpenClaw-Gateway – unbedingt ersetzen
OPENCLAW_GATEWAY_TOKEN=BITTE_EIN_LANGES_ZUFAELLIGES_TOKEN_SETZEN

# OpenAI-kompatibler Anbieter
# Beispiel OpenAI: https://api.openai.com/v1
# Beispiel OpenRouter: https://openrouter.ai/api/v1
# Beispiel lokaler Dienst: http://host.docker.internal:11434/v1
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=DEIN_API_KEY

# Externer Port der WebUI
WEBUI_PORT=8666

# Für einen Einzelbenutzerbetrieb zunächst true verwenden
WEBUI_AUTH=true
WEBUI_NAME=OpenClaw Lab
TZ=Europe/Berlin