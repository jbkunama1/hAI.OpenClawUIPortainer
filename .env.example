# Gateway-Token: Wird von Open WebUI als OPENAI_API_KEY verwendet.
# Bitte durch ein langes zufälliges Token ersetzen.
GATEWAY_TOKEN=change-me-to-a-long-random-token

# OpenAI-kompatibler LLM-Endpunkt, immer inklusive /v1
# OpenAI:
LLM_BASE_URL=https://api.openai.com/v1
# OpenRouter:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# Ollama im gleichen Docker-Netzwerk:
# LLM_BASE_URL=http://ollama:11434/v1

# API-Key des LLM-Anbieters
LLM_API_KEY=sk-your-provider-key

# Externer Port der WebUI
WEBUI_PORT=8666

# WebUI-Einstellungen
WEBUI_AUTH=true
WEBUI_NAME=OpenClaw Lab
TZ=Europe/Berlin

# Optionale MCP-Server als JSON-Array (Streamable HTTP, SSE oder stdio).
# Echte URLs und Tokens NUR in Portainer setzen, nie ins Repository.
# Beispiel mit Token aus einer separaten Variable:
# MCP_SERVERS_JSON=[{"name":"hai","transport":"http","url":"https://mcp.example.com/mcp","headers":{"Authorization":"Bearer ${HAI_MCP_TOKEN}"}}]
MCP_SERVERS_JSON=[]

# Token für MCP-Header (wird per ${HAI_MCP_TOKEN} in headers eingesetzt)
HAI_MCP_TOKEN=

# Agent / Tool-Calling
# Agent-Schleife an/aus
AGENT_ENABLED=true
# Maximale Tool-Runden pro Anfrage
AGENT_MAX_STEPS=8
# Allowlist der MCP-Tools (kommagetrennt, Suffix * erlaubt). Leer = ALLE Tools.
# Namen haben das Format <servername>__<toolname>, Liste siehe GET /api/mcp/tools
# Beispiel: MCP_TOOL_ALLOW=hai__fhem_get*,hai__fhem_list_devices,hai__web_search_exa
MCP_TOOL_ALLOW=
# Tool-Aufrufe als Zeile im Chat anzeigen
SHOW_TOOL_CALLS=true
